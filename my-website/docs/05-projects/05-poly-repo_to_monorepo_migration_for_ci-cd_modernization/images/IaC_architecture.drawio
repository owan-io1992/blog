          <mxGeometry x="10" y="27" width="38" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="ae-1" parent="after-lane" source="a-mono" target="a-proj" value="moon 編排" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2.5;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#059669;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ae-2" parent="after-lane" source="a-proj" target="a-ci" value="MR &amp;amp; CI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2563EB;strokeWidth=2.5;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#2563EB;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ae-3" parent="after-lane" source="a-ci" target="a-argo" value="Chart/Sync" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2.5;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#7C3AED;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ae-4" parent="after-lane" source="a-argo" target="a-eks" value="GitOps 部署" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=2.5;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#059669;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a-gain-1" parent="after-lane" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:13.5px;font-weight:700;color:#065F46;margin-bottom:8px;&quot;&gt;開發體驗與架構改善 (DevEx &amp;amp; Monorepo)&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px;line-height:1.45;font-size:12px;color:#334155&quot;&gt;• &lt;b&gt;一鍵標準化環境&lt;/b&gt;：devcontainer + mise + uv 統一環境與 Lockfile，準備時間 &lt;b&gt;1 hr → &amp;lt; 3 min&lt;/b&gt;。&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px;line-height:1.45;font-size:12px;color:#334155&quot;&gt;• &lt;b&gt;單一 PR 高效協作&lt;/b&gt;：統一結構後僅需提交 1 個 PR，Reviewer &lt;b&gt;只須審核單一 PR&lt;/b&gt;。&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px;line-height:1.45;font-size:12px;color:#334155&quot;&gt;• &lt;b&gt;現代化技術棧&lt;/b&gt;：moon 集中維護專案依賴；升級現代 Python（支援 ARM）並引入連線池與高效套件。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;" vertex="1">
          <mxGeometry x="24" y="164" width="452" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="a-gain-2" parent="after-lane" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:13.5px;font-weight:700;color:#065F46;margin-bottom:8px;&quot;&gt;CI/CD 現代化與 GitOps 部署 (CI/CD Efficiency)&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px;line-height:1.45;font-size:12px;color:#334155&quot;&gt;• &lt;b&gt;自動化品質把關&lt;/b&gt;：GitLab MR 強制執行 Lint / Formatter 檢查，與 devcontainer 確保 CI 環境一致。&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px;line-height:1.45;font-size:12px;color:#334155&quot;&gt;• &lt;b&gt;CI/CD 時間縮短 90%&lt;/b&gt;：moon 智慧快取與受影響範圍建置，搭配 uv 極速解析依賴。&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px;line-height:1.45;font-size:12px;color:#334155&quot;&gt;• &lt;b&gt;可靠 GitOps 交付&lt;/b&gt;：Harbor + Helm 搭配 ArgoCD 自動同步與 Rollback，部署時間 &lt;b&gt;30 min → ~3 min&lt;/b&gt;。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;" vertex="1">
          <mxGeometry x="500" y="164" width="452" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="a-gain-3" parent="after-lane" value="&lt;div style=&quot;text-align:left;&quot;&gt;&lt;div style=&quot;font-size:13.5px;font-weight:700;color:#065F46;margin-bottom:8px;&quot;&gt;雲端效能、自動擴展與可觀測性 (K8s &amp;amp; Ops)&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px;line-height:1.45;font-size:12px;color:#334155&quot;&gt;• &lt;b&gt;ARM64 成本與效能雙贏&lt;/b&gt;：遷移至 K8s (EKS) ARM64 架構，&lt;b&gt;成本降低 50%、效能提升 30%&lt;/b&gt;。&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px;line-height:1.45;font-size:12px;color:#334155&quot;&gt;• &lt;b&gt;KEDA 事件自動擴展&lt;/b&gt;：依自定義指標 / Redis 佇列動態擴容，擴展時間 &lt;b&gt;30 min → &amp;lt; 2 min&lt;/b&gt;。&lt;/div&gt;&lt;div style=&quot;margin-bottom:5px;line-height:1.45;font-size:12px;color:#334155&quot;&gt;• &lt;b&gt;全面監控與低 MTTR&lt;/b&gt;：整合 Grafana、自定義 Exporters 與告警，配合 K8s 自癒能力大幅降低 MTTR。&lt;/div&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.5;align=left;verticalAlign=top;spacing=12;" vertex="1">
          <mxGeometry x="976" y="164" width="452" height="180" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
