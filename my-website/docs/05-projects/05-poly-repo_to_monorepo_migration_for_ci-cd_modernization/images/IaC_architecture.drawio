        <mxCell id="a-ci" parent="after-lane" value="&lt;b&gt;GitLab · Jenkins · Harbor&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569&quot;&gt;MR Lint Gate + moon 快取&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#2563EB&quot;&gt;CI/CD 總時間縮短 90%&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#93C5FD;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=56;container=1;collapsible=0;recursiveResize=0;" vertex="1">
          <mxGeometry x="620" y="50" width="224" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="a-ci-icon" parent="a-ci" value="" style="shape=image;html=1;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/svg+xml,;fillColor=none;strokeColor=none;" vertex="1">
          <mxGeometry x="11" y="27" width="38" height="38" as="geometry"/>
        </mxCell>
        <mxCell id="a-argo" parent="after-lane" value="&lt;b&gt;ArgoCD + Helm&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569&quot;&gt;GitOps 宣告式同步與回滾&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#7C3AED&quot;&gt;CD 時間 30m → ~3m&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=56;container=1;collapsible=0;recursiveResize=0;" vertex="1">
          <mxGeometry x="924" y="50" width="210" height="92" as="geometry"/>
        </mxCell>
