          <mxGeometry x="12" y="25" width="34" height="42" as="geometry"/>
        </mxCell>
        <mxCell id="a-eks" parent="after-lane" value="&lt;b&gt;EKS (ARM64) + KEDA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569&quot;&gt;Grafana · Custom Exporters&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#059669&quot;&gt;-50% 成本 · +30% 效能&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#BAE6FD;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=56;container=1;collapsible=0;recursiveResize=0;" vertex="1">
          <mxGeometry x="1214" y="50" width="214" height="92" as="geometry"/>
