        <mxCell id="b-ops" parent="before-lane" value="&lt;b&gt;手動維運與擴展&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B&quot;&gt;無自定義監控與告警&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#DC2626&quot;&gt;擴展 ~30m · 高 MTTR&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;dashed=1;align=center;verticalAlign=middle;" vertex="1">
