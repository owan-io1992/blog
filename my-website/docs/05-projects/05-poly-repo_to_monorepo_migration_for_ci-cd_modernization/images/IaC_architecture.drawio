        <mxCell id="b-ec2" parent="before-lane" value="&lt;b&gt;Amazon EC2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748B&quot;&gt;主機環境準備複雜&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#DC2626&quot;&gt;Outage 難快速修復&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=56;container=1;collapsible=0;recursiveResize=0;" vertex="1">
