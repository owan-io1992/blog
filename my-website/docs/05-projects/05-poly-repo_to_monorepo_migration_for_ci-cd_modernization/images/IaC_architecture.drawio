        <mxCell id="be-1" parent="before-lane" source="b-poly" target="b-proj" value="???&lt;br&gt;複雜依賴" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#DC2626;strokeWidth=2.5;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#DC2626;fontStyle=1;labelBackgroundColor=#FFFDFD;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1">
          <mxGeometry relative="1" as="geometry"/>
