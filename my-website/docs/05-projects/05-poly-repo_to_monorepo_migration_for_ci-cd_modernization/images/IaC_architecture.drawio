        <mxCell id="a-proj" parent="after-lane" value="&lt;b&gt;10 Projects &amp;amp; Libs&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569&quot;&gt;Python 3.x · uv.lock&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#059669&quot;&gt;Conn Pool · 高效套件&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#86EFAC;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=56;container=1;collapsible=0;recursiveResize=0;" vertex="1">
